---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts, POSTS_PER_PAGE, type Post } from '../../lib/posts';

// Page 1 is `/`; this route covers 2..n (ARCHITECTURE §5 — the spec's
// "Older posts" link had no destination in the §6 route table).
export async function getStaticPaths() {
  const all = await getPublishedPosts();
  const totalPages = Math.ceil(all.length / POSTS_PER_PAGE);
  const paths = [];

  for (let page = 2; page <= totalPages; page++) {
    const start = (page - 1) * POSTS_PER_PAGE;
    paths.push({
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        posts: all.slice(start, start + POSTS_PER_PAGE),
        remaining: Math.max(0, all.length - (start + POSTS_PER_PAGE)),
      },
    });
  }

  return paths;
}

interface Props {
  page: number;
  totalPages: number;
  posts: Post[];
  remaining: number;
}

const { page, totalPages, posts, remaining } = Astro.props;
const prevHref = page === 2 ? '/' : `/page/${page - 1}/`;
---

<Base
  title={`Writing — page ${page}`}
  description={`Older posts, page ${page} of ${totalPages}.`}
>
  <header class="index-intro">
    <h1>Writing</h1>
    <p class="index-intro__lede">
      <span class="index-intro__meta">Page {page} of {totalPages}.</span>
    </p>
  </header>

  <PostList posts={posts} />

  <nav class="pagination" aria-label="Pagination">
    <a href={prevHref}>← Newer posts</a>
    {remaining > 0 && <a href={`/page/${page + 1}/`}>→ Older posts ({remaining} more)</a>}
  </nav>
</Base>
