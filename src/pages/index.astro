---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts, POSTS_PER_PAGE } from '../lib/posts';

const all = await getPublishedPosts();
const posts = all.slice(0, POSTS_PER_PAGE);
const remaining = all.length - posts.length;
const startYear = all.length
  ? Math.min(...all.map((p) => p.data.pubDate.getUTCFullYear()))
  : new Date().getUTCFullYear();

const description =
  'Notes on software architecture, cloud systems, and engineering with AI.';
---

<Base title="foyzul — writing" description={description} bareTitle>
  {/* Spec §8.1: the <h1> doubles as the active nav label. */}
  <header class="index-intro">
    <h1>Writing</h1>
    <p class="index-intro__lede">
      {description}{' '}
      <span class="index-intro__meta">
        {all.length} post{all.length === 1 ? '' : 's'} since {startYear}.
      </span>
    </p>
  </header>

  <PostList posts={posts} />

  {
    remaining > 0 && (
      <nav class="pagination" aria-label="Pagination">
        <span />
        <a href="/page/2/">→ Older posts ({remaining} more)</a>
      </nav>
    )
  }
</Base>
