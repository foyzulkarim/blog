---
// Sun/moon theme switch. Writes <html data-theme> + localStorage['theme'];
// blog.css §1.1 turns that attribute into a narrowed color-scheme.
// Hidden until the inline script in Base.astro adds .has-js — without JS the
// button cannot do anything, so it should not occupy the header.
---

<button class="theme-toggle" type="button" aria-label="Switch colour theme">
  {/* The icon shows the theme you will GET, not the one you are in. */}
  <svg
    class="theme-toggle__icon theme-toggle__moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    />
  </svg>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');

  if (btn) {
    const root = document.documentElement;
    const mq = matchMedia('(prefers-color-scheme: dark)');

    // No attribute means "follow the OS", so the resolved theme has to fall
    // back to the media query rather than assuming light.
    const resolved = () =>
      root.dataset.theme === 'dark' || root.dataset.theme === 'light'
        ? root.dataset.theme
        : mq.matches
          ? 'dark'
          : 'light';

    const relabel = () => {
      btn.setAttribute(
        'aria-label',
        resolved() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
      );
    };

    btn.addEventListener('click', () => {
      const next = resolved() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Safari private mode throws on write; the theme still applies for
        // this page, it just will not survive navigation.
      }
      relabel();
    });

    // While still on "follow the OS", a system change flips the icon too.
    mq.addEventListener('change', relabel);
    relabel();
  }
</script>
