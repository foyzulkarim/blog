---
/**
 * Utilization: how busy the limiting resource is. A tachometer-style gauge
 * at 78%, with the redline zone marked amber — foreshadowing the
 * "utilization is not linear" section.
 */
---
<figure class="perf-figure">
  <svg viewBox="0 0 620 205" xmlns="http://www.w3.org/2000/svg" role="img"
       aria-label="A semicircular tachometer-style gauge with the needle at 78 percent and the last stretch of the dial marked amber as a redline. Utilization is how busy the limiting resource is.">
    <path d="M 200 160 A 110 110 0 0 1 420 160" class="gauge" />
    <path d="M 399 95.3 A 110 110 0 0 1 420 160" class="redline" />
    <line x1="200" y1="160" x2="184" y2="160" class="tick" />
    <line x1="310" y1="50" x2="310" y2="34" class="tick" />
    <line x1="420" y1="160" x2="436" y2="160" class="tick" />
    <text x="180" y="180" text-anchor="middle" class="lbl">0</text>
    <text x="310" y="26" text-anchor="middle" class="lbl">50</text>
    <text x="440" y="180" text-anchor="middle" class="lbl">100</text>
    <line x1="310" y1="160" x2="376.3" y2="105.2" class="needle" />
    <circle cx="310" cy="160" r="6" class="hub" />
    <text x="310" y="196" text-anchor="middle" class="mono-b">78% busy</text>
  </svg>
  <figcaption>How busy is the limiting resource?</figcaption>
</figure>

<style>
  .gauge  { fill: none; stroke: var(--perf-rule, #C6D0CD); stroke-width: 7; stroke-linecap: round }
  .redline { fill: none; stroke: var(--perf-flag, #B45309); stroke-width: 7; stroke-linecap: round }
  .tick   { stroke: var(--perf-ink-soft, #4B5F66); stroke-width: 2 }
  .needle { stroke: var(--perf-ink, #12242B); stroke-width: 3; stroke-linecap: round }
  .hub    { fill: var(--perf-ink, #12242B) }
  .lbl    { font-family: var(--perf-font, ui-sans-serif, sans-serif); font-size: 12px; fill: var(--perf-ink-soft, #4B5F66) }
  .mono-b { font-family: var(--perf-mono, ui-monospace, monospace); font-size: 14px; fill: var(--perf-ink, #12242B) }
</style>
