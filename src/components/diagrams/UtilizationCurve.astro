---
/** The hockey stick. Flat until roughly 70%, then vertical. */
interface Props { caption?: string; marker?: number; markerLabel?: string }
const { caption, markerLabel = "you are here at 78%" } = Astro.props;
---
<figure class="perf-figure">
  <svg viewBox="0 0 620 260" xmlns="http://www.w3.org/2000/svg" role="img"
       aria-label="Latency plotted against utilization of the limiting resource. The curve is nearly flat until about 70 percent, then bends sharply upward. A marker sits at 78 percent, at the foot of the bend.">
    <line x1="46" y1="200" x2="600" y2="200" class="axis" />
    <line x1="46" y1="20"  x2="46"  y2="200" class="axis" />
    <text x="10" y="30" class="cap-soft">latency</text>

    <path d="M46 194 L200 190 L320 183 L400 172 L450 155 L490 126 L520 88 L545 44 L558 22"
          fill="none" class="curve" stroke-linecap="round" />

    <line x1="463" y1="20" x2="463" y2="200" class="flag-line" />
    <circle cx="463" cy="147" r="5" class="flag-dot" />
    <text x="463" y="14" text-anchor="middle" class="cap-flag">{markerLabel}</text>

    <g class="mono-soft" text-anchor="middle">
      <text x="46"  y="218">0%</text>
      <text x="230" y="218">40%</text>
      <text x="370" y="218">70%</text>
      <text x="510" y="218">90%</text>
      <text x="595" y="218">100%</text>
    </g>
    <text x="323" y="240" text-anchor="middle" class="cap-soft">utilization of the limiting resource</text>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .axis  { stroke: var(--perf-ink, #12242B); stroke-width: 1.2 }
  .curve { stroke: var(--perf-ink, #12242B); stroke-width: 2.4 }
  .flag-line { stroke: var(--perf-flag, #B45309); stroke-width: 1.4; stroke-dasharray: 4 4 }
  .flag-dot  { fill: var(--perf-flag, #B45309) }
  .cap-soft { font-family: var(--perf-font, ui-sans-serif, sans-serif); font-size: 12.5px; fill: var(--perf-ink-soft, #4B5F66) }
  .cap-flag { font-family: var(--perf-font, ui-sans-serif, sans-serif); font-size: 12.5px; font-weight: 600; fill: var(--perf-flag, #B45309) }
  .mono-soft text { font-family: var(--perf-mono, ui-monospace, monospace); font-size: 11.5px; fill: var(--perf-ink-soft, #4B5F66) }
</style>
