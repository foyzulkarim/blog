---
/**
 * Throughput: the count of finishes per second. A conveyor belt drops
 * completed requests into a bin; the counter and the one-second bracket
 * are the idea, not the motion.
 */
---
<figure class="perf-figure">
  <svg viewBox="0 0 620 190" xmlns="http://www.w3.org/2000/svg" role="img"
       aria-label="A conveyor belt carrying request boxes into a bin, with a counter reading 142 requests per second above the bin and a one-second bracket under the belt. Throughput is how many requests finish per second.">
    <text x="505" y="44" text-anchor="middle" class="mono-count">142 req/s</text>
    <rect x="70"  y="68" width="16" height="16" class="item" />
    <rect x="134" y="68" width="16" height="16" class="item" />
    <rect x="198" y="68" width="16" height="16" class="item" />
    <rect x="262" y="68" width="16" height="16" class="item" />
    <rect x="326" y="68" width="16" height="16" class="item" />
    <rect x="40" y="88" width="400" height="26" rx="13" class="panel" />
    <line x1="62" y1="101" x2="418" y2="101" class="belt" />
    <circle cx="56" cy="101" r="5" class="roller" />
    <circle cx="424" cy="101" r="5" class="roller" />
    <rect x="452" y="84" width="15" height="15" class="item" transform="rotate(22 459.5 91.5)" />
    <path d="M 470 92 L 470 140 L 540 140 L 540 92" class="bin" />
    <rect x="480" y="124" width="12" height="12" class="item" />
    <rect x="496" y="124" width="12" height="12" class="item" />
    <rect x="512" y="124" width="12" height="12" class="item" />
    <line x1="40" y1="156" x2="440" y2="156" class="rule" />
    <line x1="40" y1="150" x2="40" y2="162" class="rule" />
    <line x1="440" y1="150" x2="440" y2="162" class="rule" />
    <text x="240" y="178" text-anchor="middle" class="lbl">1 second</text>
  </svg>
  <figcaption>How many requests finish per second?</figcaption>
</figure>

<style>
  .panel  { fill: var(--perf-panel, #FFFFFF); stroke: var(--perf-ink, #12242B); stroke-width: 1.4 }
  .rule   { stroke: var(--perf-rule, #C6D0CD); stroke-width: 1 }
  .belt   { stroke: var(--perf-ink-soft, #4B5F66); stroke-width: 1; stroke-dasharray: 5 5 }
  .roller { fill: var(--perf-paper, #F1F3F2); stroke: var(--perf-ink, #12242B); stroke-width: 1.2 }
  .item   { fill: var(--perf-fast, #0E7C7B); opacity: .85 }
  .bin    { fill: none; stroke: var(--perf-ink, #12242B); stroke-width: 1.4 }
  .lbl    { font-family: var(--perf-font, ui-sans-serif, sans-serif); font-size: 12px; fill: var(--perf-ink-soft, #4B5F66) }
  .mono-count { font-family: var(--perf-mono, ui-monospace, monospace); font-size: 14px; font-weight: 600; fill: var(--perf-fast, #0E7C7B) }
</style>
