---
/** 300 sorted samples cut into 100 equal-count boxes. The core mechanic. */
interface Props { caption?: string }
const { caption = "The 100 is a convention, not a rule. The real operation is “index at some fraction of the sorted length.”" } = Astro.props;
---
<figure class="perf-figure">
  <svg viewBox="0 0 620 250" xmlns="http://www.w3.org/2000/svg" role="img"
       aria-label="300 sorted samples split into 100 boxes of 3 samples each. Samples 148 to 150 sit at the p50 boundary and samples 295 to 297 at the p99 boundary.">
    <text x="0" y="14" class="lbl">300 samples ÷ 100 boxes = 3 samples per box</text>

    <rect x="0"   y="30" width="46" height="34" class="fast-a" />
    <rect x="50"  y="30" width="46" height="34" class="fast-a" />
    <rect x="100" y="30" width="46" height="34" class="fast-a" />
    <text x="170" y="52" class="ell">· · ·</text>
    <rect x="215" y="30" width="46" height="34" class="fast-b" />
    <text x="300" y="52" class="ell">· · ·</text>
    <rect x="345" y="30" width="46" height="34" class="slow-a" />
    <text x="430" y="52" class="ell">· · ·</text>
    <rect x="474" y="30" width="46" height="34" class="slow-b" />
    <rect x="524" y="30" width="46" height="34" class="slow-c" />

    <g class="mono-mid" text-anchor="middle">
      <text x="23"  y="80">box 1</text><text x="73" y="80">2</text><text x="123" y="80">3</text>
      <text x="238" y="80">50</text><text x="368" y="80">80</text>
      <text x="497" y="80">99</text><text x="547" y="80">100</text>
    </g>

    <g class="mono-soft" text-anchor="middle">
      <text x="23"  y="100">1–3</text><text x="73" y="100">4–6</text><text x="123" y="100">7–9</text>
      <text x="238" y="100">148–150</text><text x="368" y="100">238–240</text>
      <text x="497" y="100">295–297</text><text x="547" y="100">298–300</text>
    </g>

    <line x1="261" y1="26" x2="261" y2="118" class="marker" />
    <text x="261" y="136" text-anchor="middle" class="mono-mark">p50</text>
    <line x1="520" y1="26" x2="520" y2="118" class="marker" />
    <text x="520" y="136" text-anchor="middle" class="mono-mark">p99</text>

    <line x1="0" y1="162" x2="620" y2="162" class="rule" />

    <g class="body">
      <text x="0" y="188">p95 — 5% of requests were slower than this</text>
      <text x="0" y="212">p99 — 1% were slower</text>
      <text x="0" y="236">p999 — 1 in 1000 were slower (same idea, 1000 boxes)</text>
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fast-a { fill: var(--perf-fast, #0E7C7B); opacity: .75 }
  .fast-b { fill: var(--perf-fast, #0E7C7B); opacity: .9 }
  .slow-a { fill: var(--perf-slow, #A32E63); opacity: .55 }
  .slow-b { fill: var(--perf-slow, #A32E63); opacity: .8 }
  .slow-c { fill: var(--perf-slow, #A32E63); opacity: .9 }
  .marker { stroke: var(--perf-ink, #12242B); stroke-width: 1.6 }
  .rule   { stroke: var(--perf-rule, #C6D0CD) }
  .lbl  { font-family: var(--perf-font, ui-sans-serif, sans-serif); font-size: 12.5px; fill: var(--perf-ink-soft, #4B5F66) }
  .body text, .body { font-family: var(--perf-font, ui-sans-serif, sans-serif); font-size: 13.5px; fill: var(--perf-ink, #12242B) }
  .ell  { font-family: var(--perf-mono, ui-monospace, monospace); font-size: 15px; fill: var(--perf-ink-soft, #4B5F66) }
  .mono-mid text  { font-family: var(--perf-mono, ui-monospace, monospace); font-size: 11.5px; fill: var(--perf-ink, #12242B) }
  .mono-soft text { font-family: var(--perf-mono, ui-monospace, monospace); font-size: 11px; fill: var(--perf-ink-soft, #4B5F66) }
  .mono-mark { font-family: var(--perf-mono, ui-monospace, monospace); font-size: 13px; font-weight: 700; fill: var(--perf-ink, #12242B) }
</style>
