---
/*
 * SlideTranscripts — per-slide speaker transcripts for a .slides-deck.
 *
 * Progressive enhancement, on purpose. This component renders the narration
 * for each slide into inert <template> elements (keyed by the slide's
 * `data-label`), and a hoisted client script grafts an in-slide segmented
 * control ("Slide / Transcript") plus a transcript overlay onto every matching
 * <section class="slide">. Nothing here is a `.slide`, so the deck's slide
 * count and active-slide tracking in SlidesNav are untouched.
 *
 * Why <template> and not a JS blob: the narration stays in the server-rendered
 * HTML (indexable, works before hydration) while contributing zero layout.
 *
 * Usage (inside the deck, once):
 *   import { transcripts } from '../data/agentic-foundations-transcripts.ts';
 *   <SlideTranscripts transcripts={transcripts} />
 *
 * The paired global toggle is the `[data-transcripts-toggle]` button in the
 * deck's nav bar; this script wires it to open/close every transcript at once.
 */

export interface Props {
  /** Map of slide `data-label` → array of narration paragraphs. */
  transcripts: Record<string, string[]>;
}

const { transcripts } = Astro.props;
const entries = Object.entries(transcripts).filter(
  ([, paras]) => Array.isArray(paras) && paras.some((p) => p.trim().length > 0),
);
---

<div class="slide-transcripts-store" hidden aria-hidden="true">
  {
    entries.map(([label, paras]) => (
      <template class="slide-transcript-data" data-transcript-for={label}>
        {paras.map((p) => (
          <p>{p}</p>
        ))}
      </template>
    ))
  }
</div>

<script>
  function initTranscripts(): void {
    document
      .querySelectorAll<HTMLElement>('.slides-deck')
      .forEach((deck) => {
        const store = deck.querySelector<HTMLElement>('.slide-transcripts-store');
        if (!store) return;

        const templates = new Map<string, HTMLTemplateElement>();
        store
          .querySelectorAll<HTMLTemplateElement>('template[data-transcript-for]')
          .forEach((t) => {
            const key = t.getAttribute('data-transcript-for');
            if (key) templates.set(key, t);
          });
        if (!templates.size) return;

        const slides = Array.from(deck.querySelectorAll<HTMLElement>('.slide'));
        const enhanced: HTMLElement[] = [];
        let uid = 0;

        for (const slide of slides) {
          const label = slide.getAttribute('data-label');
          if (!label) continue;
          const tpl = templates.get(label);
          if (!tpl) continue;

          uid += 1;
          const panelId = `slide-transcript-panel-${uid}`;
          const titleEl =
            slide.querySelector<HTMLElement>('.slide-title, .cover-title');
          const heading = titleEl?.textContent?.trim() || label;

          /* Segmented control: reads as two tabs, behaves as one toggle. */
          const control = document.createElement('div');
          control.className = 'slide-transcript';
          control.setAttribute('role', 'group');
          control.setAttribute('aria-label', `View for “${heading}”`);
          control.innerHTML =
            `<button type="button" class="slide-transcript__seg" data-view="slide" aria-pressed="true">Slide</button>` +
            `<button type="button" class="slide-transcript__seg" data-view="transcript" aria-pressed="false" aria-expanded="false" aria-controls="${panelId}">Transcript</button>`;

          const panel = document.createElement('div');
          panel.className = 'slide-transcript__panel';
          panel.id = panelId;
          panel.setAttribute('role', 'region');
          panel.setAttribute('aria-label', `Transcript — ${heading}`);
          panel.setAttribute('tabindex', '-1');
          panel.setAttribute('aria-hidden', 'true');

          const inner = document.createElement('div');
          inner.className = 'slide-transcript__inner';
          const head = document.createElement('div');
          head.className = 'slide-transcript__head';
          head.innerHTML =
            `<span class="slide-transcript__kicker">Transcript</span>` +
            `<span class="slide-transcript__title">${heading}</span>` +
            `<button type="button" class="slide-transcript__close" aria-label="Close transcript">Close ✕</button>`;
          const body = document.createElement('div');
          body.className = 'slide-transcript__body';
          body.appendChild(tpl.content.cloneNode(true));
          inner.append(head, body);
          panel.appendChild(inner);

          slide.classList.add('has-transcript');
          slide.append(control, panel);
          enhanced.push(slide);

          const segSlide = control.querySelector<HTMLElement>('[data-view="slide"]')!;
          const segScript = control.querySelector<HTMLElement>('[data-view="transcript"]')!;
          const closeBtn = head.querySelector<HTMLElement>('.slide-transcript__close')!;

          const setOpen = (open: boolean, focusPanel = false): void => {
            slide.classList.toggle('transcript-open', open);
            panel.setAttribute('aria-hidden', open ? 'false' : 'true');
            segSlide.setAttribute('aria-pressed', open ? 'false' : 'true');
            segScript.setAttribute('aria-pressed', open ? 'true' : 'false');
            segScript.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open && focusPanel) panel.focus();
          };
          /* Store the setter so the global toggle can drive every slide. */
          (slide as any).__setTranscriptOpen = setOpen;

          segScript.addEventListener('click', () => setOpen(true, true));
          segSlide.addEventListener('click', () => setOpen(false));
          closeBtn.addEventListener('click', () => {
            setOpen(false);
            segScript.focus();
          });

          /* Esc while focus is inside the panel closes it and does NOT bubble,
             so it never reaches SlidesNav's document-level Esc (which would
             exit presentation mode). Order-independent by design. */
          panel.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Escape') {
              e.stopPropagation();
              setOpen(false);
              segScript.focus();
            }
          });
        }

        if (!enhanced.length) return;

        /* Global toggle in the nav bar: open all / close all. */
        const globalBtn =
          deck.querySelector<HTMLElement>('[data-transcripts-toggle]');
        globalBtn?.addEventListener('click', () => {
          const willOpen =
            globalBtn.getAttribute('aria-pressed') !== 'true';
          globalBtn.setAttribute('aria-pressed', willOpen ? 'true' : 'false');
          for (const slide of enhanced) {
            (slide as any).__setTranscriptOpen?.(willOpen);
          }
        });

        /* `t` toggles the transcript of whichever slide is centered in view.
           Guarded like SlidesNav's keys: ignore modifiers and text inputs. */
        document.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key !== 't' && e.key !== 'T') return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          const target = e.target;
          if (
            target instanceof HTMLInputElement ||
            target instanceof HTMLTextAreaElement ||
            (target instanceof HTMLElement && target.isContentEditable)
          )
            return;

          const mid = window.innerHeight / 2;
          let best: HTMLElement | null = null;
          let bestDist = Infinity;
          for (const slide of enhanced) {
            const r = slide.getBoundingClientRect();
            if (r.bottom < 0 || r.top > window.innerHeight) continue;
            const dist = Math.abs((r.top + r.bottom) / 2 - mid);
            if (dist < bestDist) {
              bestDist = dist;
              best = slide;
            }
          }
          if (!best) return;
          e.preventDefault();
          const isOpen = best.classList.contains('transcript-open');
          (best as any).__setTranscriptOpen?.(!isOpen, !isOpen);
        });
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTranscripts, { once: true });
  } else {
    initTranscripts();
  }
</script>
