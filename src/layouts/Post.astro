---
import Base from './Base.astro';
import TagChips from '../components/TagChips.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { formatDate, isoDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, lang } = post.data;
// Astro 7's glob loader no longer exposes `.slug` on the collection entry —
// only `.id`. The route param in [...slug].astro is also derived from `id`,
// so this stays in sync with the public URL.
//
// Per-post OG image resolution, in order:
//   1. frontmatter `ogImage` (explicit, post-author choice — preferred)
//   2. src/content/posts/<id>/images/hero.webp  (convention)
//   3. public/og-<id>.png                       (legacy curated social cards)
//   4. public/og-default.png                    (site fallback)
const explicitOg = post.data.ogImage?.src;

const heroWebps = import.meta.glob<string>(
  '/src/content/posts/*/images/hero.webp',
  { eager: true, query: '?url', import: 'default' },
);
const heroRel = heroWebps[`/src/content/posts/${post.id}/images/hero.webp`];

const publicOgPngs = import.meta.glob<string>('/public/og-*.png', {
  eager: true,
  import: 'default',
});
const hasPublicOg = Object.keys(publicOgPngs).some((p) =>
  p.endsWith(`/og-${post.id}.png`),
);

const ogRel =
  explicitOg ??
  heroRel ??
  (hasPublicOg ? `/og-${post.id}.png` : '/og-default.png');
const ogImage = new URL(ogRel, Astro.site).href;
---

<Base title={title} description={description} lang={lang} ogType="article" ogImage={ogImage}>
  {/*
    Spec §5.1 / §9.2: exactly ONE <article> per post. It spans every grid
    track and re-exposes them via subgrid (blog.css §3), so a bleed figure
    inside can reach the full width without the post being split.
  */}
  <article class="post">
    <h1>{title}</h1>
    <p class="post-meta">
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
      {
        updatedDate && (
          <span>
            Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
          </span>
        )
      }
    </p>
    <ShareButtons url={Astro.url.href} title={title} />
    {/* The lede is authored in the post body, so the frontmatter
        description stays short enough for the index row (spec §5.2). */}
    <slot />
    <TagChips tags={tags} lang={lang} />
  </article>
</Base>
