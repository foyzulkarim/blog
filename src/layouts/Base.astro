---
import '../styles/blog.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** Document language. Post pages in Bengali pass 'bn'. */
  lang?: 'en' | 'bn';
  /** Home page supplies its own full title instead of the "— foyzul" suffix. */
  bareTitle?: boolean;
  /** Override og:type (e.g. 'article' for blog posts). Defaults to 'website'. */
  ogType?: string;
  /** Override og:image with a per-page image URL. Defaults to site default. */
  ogImage?: string;
}

const { title, description, lang = 'en', bareTitle = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = bareTitle ? title : `${title} — foyzul`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Must stay inline and before the stylesheet: these pages are static, so
        a deferred script would run after first paint and a reader on the dark
        theme would get a white flash on every navigation. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('has-js');
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
        } catch (e) {
          /* storage blocked — fall through to the OS preference */
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Foyzul Karim" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="foyzul" href="/rss.xml" />

    <meta property="og:type" content={Astro.props.ogType ?? 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="foyzul" />
    <meta property="og:image" content={Astro.props.ogImage ?? new URL('/og-default.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={Astro.props.ogImage ?? new URL('/og-default.png', Astro.site)} />

    {/* Umami analytics — replace YOUR_WEBSITE_ID with your actual Umami website ID */}
    <script defer src="https://cloud.umami.is/script.js" data-website-id="6ab9452a-5c1f-4f96-9625-e1909c654763"></script>

    {/* Google Translate — free widget, no API key. pageLanguage:'auto' picks up
        the html lang attribute (en or bn) so translated posts are detected.
        SIMPLE layout drops the "Powered by" line so the header stays clean. */}
    <script type="text/javascript">
      function googleTranslateElementInit() {
        new google.translate.TranslateElement(
          {
            pageLanguage: 'auto',
            layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
            autoDisplay: false,
          },
          'google_translate_element',
        );
      }
    </script>
    <script
      type="text/javascript"
      src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
    ></script>

    {/* The two faces every English page renders immediately. */}
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    {/* Spec §5.1: first focusable element on the page. */}
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main class="page" id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
