{
  // Static assets only — no `main`, because there is no Worker code to run.
  // The Worker name here must match the Worker name in the Cloudflare
  // dashboard, or a Git-connected build will fail.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-foyzul-com",
  "compatibility_date": "2026-07-30",

  // Custom Domain, not a Route: Cloudflare creates the proxied DNS record in
  // the foyzul.com zone and issues the cert on deploy. Do not hand-create a
  // `blog` record — it would collide with the one provisioned here.
  "routes": [
    {
      "pattern": "blog.foyzul.com",
      "custom_domain": true
    }
  ],

  // blog.foyzul.com is the only hostname: a second live copy on workers.dev
  // would be duplicate content for crawlers. Stated explicitly because these
  // default off once `routes` is set, and preview_urls defaults to workers_dev
  // — an implicit pair that is easy to trip over.
  // Preview a draft locally with `npm run dev`, or `npx wrangler dev` to also
  // exercise the asset handling configured below.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",

    // Without this, an unmatched path returns a null-body 404 and the
    // built dist/404.html is never served.
    "not_found_handling": "404-page",

    // Astro builds every page as <slug>/index.html (trailingSlash: 'always'),
    // which this resolves with the trailing slash. /about redirects to /about/.
    "html_handling": "auto-trailing-slash"
  }
}
